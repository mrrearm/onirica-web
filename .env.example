# Copia questo file in ".env" (mai committare .env nel repository).

# Consigliata: una stringa segreta lunga e casuale, usata per firmare le
# sessioni di accesso degli utenti. Se manca, il server ne genera una
# temporanea a ogni avvio - funziona, ma tutti dovranno rifare login a
# ogni riavvio del servizio. Genera la tua con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Facoltativo: se impostata, l'interpretazione usa Groq (gratuito) invece
# del motore locale a regole.
# Chiave gratuita su https://console.groq.com (API Keys).
GROQ_API_KEY=

# Facoltativo: necessario SOLO se ospiti l'app su un hosting gratuito
# senza disco persistente (es. Render). Se lasciate vuote, l'app usa un
# file JSON locale (comportamento di default, adatto al self-host su NAS).
# Database gratuito su https://turso.tech (Database URL + Auth Token).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
